# Production environment template
ENV=production
PORT=8004
DATABASE_URL=postgresql+asyncpg://aoe2user:replace-me@localhost:5432/aoe2db
CHAIN_ID=11865
WOLO_CHAIN_ID=11865
ALLOWED_ORIGINS=https://aoe2war.com,https://www.aoe2war.com
FASTAPI_API_URL=https://api-prodn.aoe2war.com

# Security / admin
# ADMIN_TOKEN=replace-with-admin-token
# INTERNAL_API_KEY=replace-with-shared-upload-key
# AOE2_WEB_REPLAY_POST_INGEST_URL=http://127.0.0.1:3030/api/replay/post-ingest
# AOE2_WEB_REPLAY_POST_INGEST_MAX_ATTEMPTS=3
# AOE2_WEB_REPLAY_POST_INGEST_TIMEOUT_SECONDS=5
# AOE2_WEB_REPLAY_POST_INGEST_RETRY_BASE_SECONDS=0.25

# Safety toggles
# AUTO_CREATE_TABLES=false
# LOG_REQUESTS=false
# ALLOW_UNVERIFIED_BEARER_IDENTITY=false
# TRAFFIC_RESPONSE_CACHE_SECONDS=20
